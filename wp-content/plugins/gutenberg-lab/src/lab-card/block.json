{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/lab-card",
	"version": "0.3.0",
	"title": "Lab Card",
	"category": "widgets",
	"icon": "format-image",
	"description": "One card: image, title, description, and CTA link. Use inside Lab Cards.",
	"keywords": [ "card", "image", "cta", "lab" ],
	"parent": [ "create-block/lab-cards" ],
	"attributes": {
		"imageId": {
			"type": "number"
		},
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"ctaText": {
			"type": "string",
			"default": "Learn more"
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"ctaOpensInNewTab": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		},
		"html": false,
		"reusable": false
	},
	"textdomain": "gutenberg-lab",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
