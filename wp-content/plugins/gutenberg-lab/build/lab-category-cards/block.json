{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/lab-category-cards",
  "version": "0.1.0",
  "title": "Lab Category Cards",
  "category": "widgets",
  "icon": "category",
  "description": "Display categories as cards. Choose All, Include only, or Exclude specific categories.",
  "keywords": [
    "category",
    "categories",
    "cards",
    "taxonomy",
    "lab"
  ],
  "attributes": {
    "columns": {
      "type": "number",
      "default": 3
    },
    "termsToShow": {
      "type": "number",
      "default": 12
    },
    "orderBy": {
      "type": "string",
      "default": "name"
    },
    "order": {
      "type": "string",
      "default": "asc"
    },
    "source": {
      "type": "string",
      "default": "all"
    },
    "selectedTermIds": {
      "type": "array",
      "default": []
    },
    "hideEmpty": {
      "type": "boolean",
      "default": true
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "showCta": {
      "type": "boolean",
      "default": true
    },
    "ctaText": {
      "type": "string",
      "default": "View posts"
    },
    "descriptionLines": {
      "type": "number",
      "default": 3
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "textdomain": "gutenberg-lab",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}